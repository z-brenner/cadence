# Postgres. Neon, Supabase, or any Postgres behind Cloudflare Hyperdrive.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the deployment. http://localhost:5173 for local dev.
BETTER_AUTH_URL=http://localhost:5173
APP_NAME=Cadence
# Only needed on Vercel; bearer token the cron uses to call /api/cron/snapshots.
CRON_SECRET=
