{
  "name": "cadence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted work tracker with a technical mode and a knowledge-work mode. Deploys to Cloudflare or Vercel.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "deploy:vercel": "vercel deploy --prod"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.10",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.143.0"
  }
}
